{
	"schemaVersion": 1,
	"id": "${modId}",
	"version": "${version}",
	"name": "${modName}",
	"description": "${description}",
	"authors": ["Syrup Studios"],
	"contact": {
		"homepage": "${homepage}",
		"issues": "${issues}",
		"sources": "${sources}"
	},
	"license": "${license}",
	"icon": "assets/syrup-core/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.syrupstudios.syrupcore.loaders.fabric.FabricEntrypoint"
		]
	},
	"mixins": ["syrup-core.client.mixins.json"],
	"depends": {
		"fabricloader": ">=${fabricLoader}",
		"minecraft": "${minecraftRange}",
		"java": ">=${javaVersion}",
		"fabric-api": ">=${fabricApi}"
	}
}
